<?xml version="1.0" encoding="utf-8"?>
<!-- Release/default: HTTPS only, system trust anchors.
     Local development cleartext exceptions live in src/debug/res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
