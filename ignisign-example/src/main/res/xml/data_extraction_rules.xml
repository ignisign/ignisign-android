<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules - excludes sensitive data from backups
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- SECURITY: Exclude sensitive data from cloud backups -->
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <!-- SECURITY: Exclude sensitive data from device transfers -->
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>